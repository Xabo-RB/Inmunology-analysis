Cell["\<\
R=\\frac{\\text{CT} \\text{$\\varepsilon $0} \\left(b
   \\left(\\text{rminus}^2 \\left(1-3
   \\text{rplus}^2\\right)+\\text{rminus}
   \\text{rplus}+\\text{rplus}^2\\right)+\\text{koff}
   \\left(\\text{rminus}^2 \\left(1-2
   \\text{rplus}^2\\right)+\\text{rminus}
   \\text{rplus}+\\text{rplus}^2\\right)-\\left(\\text{rminus}^2
   \\left(3 \\text{rplus}^2-1\\right)-\\text{rminus}
   \\text{rplus}-\\text{rplus}^2\\right) (\\text{kp}+\\gamma 
   P)\\right)}{\\left(\\text{rminus}^2+\\text{rminus}
   \\text{rplus}+\\text{rplus}^2\\right) (b+\\text{koff}+2
   \\text{kp}+\\gamma  P)}+\\frac{\\text{CT} \\text{$\\varepsilon $1}
   \\left(\\text{kp} \\left(\\text{rminus}^2 \\left(1-3
   \\text{rplus}^2\\right)+\\text{rminus}
   \\text{rplus}+\\text{rplus}^2\\right)-\\text{koff}
   \\text{rminus}^2
   \\text{rplus}^2\\right)}{\\left(\\text{rminus}^2+\\text{rminus}
   \\text{rplus}+\\text{rplus}^2\\right) (b+\\text{koff}+2
   \\text{kp}+\\gamma  P)}+\\frac{\\text{CT} \\text{rminus}^2
   \\text{rplus}^2}{\\text{rminus}^2+\\text{rminus}
   \\text{rplus}+\\text{rplus}^2}\
\>", "Output",
 CellChangeTimes->{3.961560736216291*^9, 3.962874373155466*^9},
 CellLabel->
  "Out[11]//TeXForm=",ExpressionUUID->"3bac6f85-8f90-47c2-8fe0-b9a76eb71b5c"]
