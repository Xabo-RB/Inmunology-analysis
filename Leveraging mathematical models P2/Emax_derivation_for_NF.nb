Cell["\<\
\\left\\{\\left\\{R\\to \\frac{\\text{CT} \\left(b (1-3
   \\text{$\\varepsilon $0}) r^2 \\text{rplus}^2+b
   \\text{$\\varepsilon $0} \\left(\\text{rminus}^2+\\text{rminus}
   \\text{rplus}+\\text{rplus}^2\\right)-\\text{koff} r^2
   \\text{rplus}^2 (2 \\text{$\\varepsilon $0}+\\text{$\\varepsilon
   $1}-1)+\\text{$\\varepsilon $0} \\text{koff}
   \\left(\\text{rminus}^2+\\text{rminus}
   \\text{rplus}+\\text{rplus}^2\\right)-3 \\text{$\\varepsilon $0}
   \\text{kp} r^2 \\text{rplus}^2-3 \\text{$\\varepsilon $1}
   \\text{kp} r^2 \\text{rplus}^2+2 \\text{kp} r^2
   \\text{rplus}^2+\\text{$\\varepsilon $0} \\text{kp}
   \\text{rminus}^2+\\text{$\\varepsilon $1} \\text{kp}
   \\text{rminus}^2+\\text{$\\varepsilon $0} \\text{kp} \\text{rminus}
   \\text{rplus}+\\text{$\\varepsilon $1} \\text{kp} \\text{rminus}
   \\text{rplus}+\\text{$\\varepsilon $0} \\text{kp}
   \\text{rplus}^2+\\text{$\\varepsilon $1} \\text{kp}
   \\text{rplus}^2-3 \\gamma  \\text{$\\varepsilon $0} P r^2
   \\text{rplus}^2+\\gamma  P r^2 \\text{rplus}^2+\\gamma 
   \\text{$\\varepsilon $0} P \\text{rminus}^2+\\gamma 
   \\text{$\\varepsilon $0} P \\text{rminus} \\text{rplus}+\\gamma 
   \\text{$\\varepsilon $0} P
   \\text{rplus}^2\\right)}{\\left(\\text{rminus}^2+\\text{rminus}
   \\text{rplus}+\\text{rplus}^2\\right) (b+\\text{koff}+2
   \\text{kp}+\\gamma  P)}\\right\\}\\right\\}\
\>", "Output",
 CellChangeTimes->{{3.961559960930173*^9, 3.961559966632448*^9}},
 CellLabel->
  "Out[13]//TeXForm=",ExpressionUUID->"2c823493-4024-468b-bf58-b4674dcfc531"]
}, Open  ]],

