Cell["\<\
R=\\frac{\\text{CT} \\text{$\\varepsilon $0} \\left(b \\left(\\left(1-3
   r^2\\right) \\text{rplus}^2+\\text{rminus}^2+\\text{rminus}
   \\text{rplus}\\right)+\\text{koff} \\left(-2 r^2
   \\text{rplus}^2+\\text{rminus}^2+\\text{rminus}
   \\text{rplus}+\\text{rplus}^2\\right)+(\\text{kp}+\\gamma  P)
   \\left(-3 r^2 \\text{rplus}^2+\\text{rminus}^2+\\text{rminus}
   \\text{rplus}+\\text{rplus}^2\\right)\\right)}{\\left(\\text{rminus}
   ^2+\\text{rminus} \\text{rplus}+\\text{rplus}^2\\right)
   (b+\\text{koff}+2 \\text{kp}+\\gamma  P)}+\\frac{\\text{CT}
   \\text{$\\varepsilon $1} \\left(\\text{kp} \\left(\\left(1-3
   r^2\\right) \\text{rplus}^2+\\text{rminus}^2+\\text{rminus}
   \\text{rplus}\\right)-\\text{koff} r^2
   \\text{rplus}^2\\right)}{\\left(\\text{rminus}^2+\\text{rminus}
   \\text{rplus}+\\text{rplus}^2\\right) (b+\\text{koff}+2
   \\text{kp}+\\gamma  P)}+\\frac{\\text{CT} r^2
   \\text{rplus}^2}{\\text{rminus}^2+\\text{rminus}
   \\text{rplus}+\\text{rplus}^2}\
\>", "Output",
 CellChangeTimes->{3.961560736216291*^9},
 CellLabel->
  "Out[18]//TeXForm=",ExpressionUUID->"54603d11-153c-4ed7-b190-3acd3d16dd29"]
}, Open  ]]
