Cell["\<\
\\left\\{\\left\\{R\\to \\frac{\\text{CT} \\left(b \\left(\\text{rminus}^2
   \\left(\\text{$\\varepsilon $0}-3 \\text{$\\varepsilon $0}
   \\text{rplus}^2+\\text{rplus}^2\\right)+\\text{$\\varepsilon $0}
   \\text{rminus} \\text{rplus}+\\text{$\\varepsilon $0}
   \\text{rplus}^2\\right)+\\text{koff} \\left(\\text{rminus}^2
   \\left(\\text{$\\varepsilon $0}-\\text{rplus}^2 (2
   \\text{$\\varepsilon $0}+\\text{$\\varepsilon
   $1}-1)\\right)+\\text{$\\varepsilon $0} \\text{rminus}
   \\text{rplus}+\\text{$\\varepsilon $0}
   \\text{rplus}^2\\right)+\\text{$\\varepsilon $0} \\text{kp}
   \\text{rminus}^2+\\text{$\\varepsilon $1} \\text{kp}
   \\text{rminus}^2-3 \\text{$\\varepsilon $0} \\text{kp}
   \\text{rminus}^2 \\text{rplus}^2-3 \\text{$\\varepsilon $1}
   \\text{kp} \\text{rminus}^2 \\text{rplus}^2+2 \\text{kp}
   \\text{rminus}^2 \\text{rplus}^2+\\text{$\\varepsilon $0}
   \\text{kp} \\text{rminus} \\text{rplus}+\\text{$\\varepsilon $1}
   \\text{kp} \\text{rminus} \\text{rplus}+\\text{$\\varepsilon $0}
   \\text{kp} \\text{rplus}^2+\\text{$\\varepsilon $1} \\text{kp}
   \\text{rplus}^2+\\gamma  \\text{$\\varepsilon $0} P
   \\text{rminus}^2-3 \\gamma  \\text{$\\varepsilon $0} P
   \\text{rminus}^2 \\text{rplus}^2+\\gamma  P \\text{rminus}^2
   \\text{rplus}^2+\\gamma  \\text{$\\varepsilon $0} P \\text{rminus}
   \\text{rplus}+\\gamma  \\text{$\\varepsilon $0} P
   \\text{rplus}^2\\right)}{\\left(\\text{rminus}^2+\\text{rminus}
   \\text{rplus}+\\text{rplus}^2\\right) (b+\\text{koff}+2
   \\text{kp}+\\gamma  P)}\\right\\}\\right\\}\
\>", "Output",
 CellChangeTimes->{{3.961559960930173*^9, 3.961559966632448*^9}, 
   3.9628743655134583`*^9},
 CellLabel->
  "Out[8]//TeXForm=",ExpressionUUID->"a5c1aef6-7802-4006-a00a-9638927b3164"]
}, Open  ]],

